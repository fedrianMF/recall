                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "position": {
                                                        "type": "string"
                                                    },
                                                    "games": {
                                                        "type": "integer"
                                                    },
                                                    "wins": {
                                                        "type": "integer"
                                                    },
                                                    "winrate": {
                                                        "type": "number"
                                                    },
                                                    "kda": {
                                                        "type": "number"
                                                    },
                                                    "cs_per_min": {
                                                        "type": "number"
                                                    },
                                                    "damage_per_min": {
                                                        "type": "number"
                                                    },
                                                    "kill_participation": {
                                                        "type": [
                                                            "number",
                                                            "null"
                                                        ]
                                                    }
                                                },
                                                "required": [
                                                    "position",
                                                    "games",
                                                    "wins",
                                                    "winrate",
                                                    "kda",
                                                    "cs_per_min",
                                                    "damage_per_min",
                                                    "kill_participation"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
