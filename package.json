    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "ajv": "8.20.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.87.0",
    "eslint-plugin-vue": "~10.11.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.87.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vite-plugin-vue-devtools": "^8.2.1",
