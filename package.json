{
  "name": "recall",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "run-s lint:check format:check test build",
    "lint": "run-s lint:oxlint lint:eslint",
