# En .env: origen de la API compartido por desarrollo y compilación.
# Debe usar http:// o https:// y no incluir ruta, consulta ni fragmento.
VITE_API_URL=http://recall-api.aime.test

# En .env.development: usa true para activar datos simulados solo con npm run dev.
# Cualquier otro valor usa la API real.
# Un build de producción con mocks o sin una VITE_API_URL válida se rechaza al compilar.
VITE_USE_MOCKS=true
