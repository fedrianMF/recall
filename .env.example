# Origen de la API, con http:// o https:// y sin ruta, consulta ni fragmento.
VITE_API_URL=http://recall-api.aime.test
# Usa true para activar los datos simulados; cualquier otro valor usa la API real.
# VITE_USE_MOCKS=true solo está permitido en desarrollo y se rechaza en producción.
VITE_USE_MOCKS=true
